DB_USER=
DB_PASSWORD=
GOOGLE_API_KEY=

# Optional. Falls back to 1 if unset (see DEFAULT_USER_ID in server.js).
DEFAULT_USER_ID=1

# --- New: Google OAuth (YouTube account connection) ---
# Create these in Google Cloud Console > APIs & Services > Credentials.
# See the setup guide in the write-up for exact steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/youtube/callback

# Any long random string (used to sign the session cookie used only
# during the OAuth round-trip). Example generator:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the browser is redirected back to after Google OAuth completes.
# The backend now also serves the frontend directly (see server.js), so
# the default below works out of the box for local development.
FRONTEND_URL=http://localhost:3000