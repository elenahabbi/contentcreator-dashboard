# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# MySQL password for the local 'root' user used by server.js
DB_PASSWORD=your_mysql_password

# users.user_id every write is attributed to until login exists
DEFAULT_USER_ID=1

# Google API key with "YouTube Data API v3" enabled
# (Google Cloud Console -> APIs & Services -> Credentials -> Create API key)
GOOGLE_API_KEY=your_google_api_key
